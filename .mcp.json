{
  "mcpServers": {
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y @playwright/mcp@latest --headless --isolated --no-sandbox --executable-path \"$(ls -d /opt/pw-browsers/chromium-*/chrome-linux64/chrome | sort -V | tail -1)\""
      ]
    },
    "chrome-devtools": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y chrome-devtools-mcp@latest --headless --isolated --no-usage-statistics --chrome-arg=--no-sandbox --chrome-arg=--disable-setuid-sandbox --executablePath \"$(ls -d /opt/pw-browsers/chromium-*/chrome-linux64/chrome | sort -V | tail -1)\""
      ]
    }
  }
}
